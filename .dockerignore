# Keep the build context small — only ship what's needed for the wheel.

# Local virtualenvs
.venv/
docs/.venv/

# Build / test caches
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Docs output
docs/_build/

# VCS + IDE
.git/
.gitignore
.gitattributes
.editorconfig
.vscode/
.idea/

# CI / project metadata not needed at runtime
.gitlab-ci.yml
Makefile
docs/
deploy/compose/
scripts/
tests/
# Note: alembic/ + alembic.ini are intentionally INCLUDED in the
# build context — the runtime image ships them so the compose
# `migrate-postgres` init-container (and the Helm pre-install hook
# in the future) can run `python -m alembic upgrade head` without
# a host bind-mount. See eveys-mobility/OCPP#234.
AGENTS.md
CLAUDE.md
