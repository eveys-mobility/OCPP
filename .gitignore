# Sphinx build output and venv
docs/_build/
docs/.venv/

# Python project venv (created by uv)
.venv/

# Python build / cache artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type-checker caches
.mypy_cache/
.ruff_cache/

# Generated protobuf / grpclib stubs (regenerate with `make protoc`).
# The top-level __init__.py is hand-written (sets up sys.path for the
# generated absolute imports); everything else is generated.
src/eveys_ocpp/_generated/*
!src/eveys_ocpp/_generated/__init__.py

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# AI assistant local config / caches — not tracked in this repo
.cursor/
.claude/
.aider*
.copilot/
.continue/
.windsurf/
.cursorignore
.cursorrules
.aiderignore
CLAUDE.md
AGENTS.md
.github/copilot-instructions.md

# macOS
.DS_Store

# Local env overrides
.env
.env.local
*.local

# Dev TLS certs for the Envoy edge listener (E5-1). Regenerated by
# scripts/gen-dev-certs.sh. Never commit; production certs come from
# cert-manager / external-secrets, not the repo.
deploy/envoy/certs/
# E5-5 — upstream-cert mount path. CI stages dev certs here for
# `envoy --mode validate`; production mounts from a Helm-provisioned
# Secret. Never commit.
deploy/envoy/upstream-certs/
