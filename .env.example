# Charge-point gateway — quickstart .env template.
#
# Copy to .env and fill in the values for your environment:
#     cp .env.example .env
#
# This file lists the variables most operators actually need to set on a
# fresh install. For the full list of every knob the gateway supports,
# see .env.reference (generated from src/eveys_ocpp/settings.py via
# `make config-export`) or docs/11-configuration-reference.md.
#
# Token pairing with the backend (eveys backend, optional):
#
#   gateway -> backend   signed with EVEYS_OCPP_BACKEND_TOKEN
#                        (accepted on backend side as
#                         CHARGE_POINT_GATEWAY_INBOUND_TOKEN)
#   backend -> gateway   signed with the backend's
#                        CHARGE_POINT_GATEWAY_OUTBOUND_TOKEN
#                        (must appear in EVEYS_OCPP_REST_INBOUND_TOKENS)
#   webhook signature    symmetric — same secret both sides
#
# Generate a random token: `openssl rand -hex 32`

# ---- REST server (the gateway exposes its admin API on :8080) --------
EVEYS_OCPP_REST_HOST=0.0.0.0
EVEYS_OCPP_REST_PORT=8080

# Comma-separated allowlist of accepted bearer tokens. The Console
# server and any backend that calls into the gateway use one of these.
# Add a second token to perform a rotation without downtime.
EVEYS_OCPP_REST_INBOUND_TOKENS=replace-with-openssl-rand-hex-32

# ---- Backend client (optional — leave empty for sim-only mode) -------
# An empty base URL disables the backend HTTP client: Authorize and
# session lifecycle skip the round-trip and the gateway accepts
# locally. Set this to the backend's `/api/eveys` base URL to enable
# real Authorize / sessions/open / sessions/close calls.
EVEYS_OCPP_BACKEND_BASE_URL=
EVEYS_OCPP_BACKEND_TOKEN=replace-with-openssl-rand-hex-32
EVEYS_OCPP_BACKEND_AUTHORIZE_FALLBACK=accept_offline
EVEYS_OCPP_BACKEND_REGISTER_FALLBACK=accept_offline

# ---- Webhooks (gateway -> backend; optional) -------------------------
# Symmetric HMAC-SHA-256 secret. Must match the backend's
# CHARGE_POINT_GATEWAY_WEBHOOK_SECRET — rotate both sides in lockstep.
EVEYS_OCPP_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# The auto-derived URL is `<base>/<event-slug>` (e.g. `<base>/cp-boot`).
# Override per-event when the backend uses a different slug.
EVEYS_OCPP_WEBHOOK_BASE_URL=
# EVEYS_OCPP_WEBHOOK_URL_CP_BOOT=
# EVEYS_OCPP_WEBHOOK_URL_CP_ONLINE=
# EVEYS_OCPP_WEBHOOK_URL_CP_OFFLINE=
# EVEYS_OCPP_WEBHOOK_URL_CP_STATUS=
# EVEYS_OCPP_WEBHOOK_URL_CP_HEARTBEAT=
# EVEYS_OCPP_WEBHOOK_URL_TX_STARTED=
# EVEYS_OCPP_WEBHOOK_URL_TX_STOPPED=
EVEYS_OCPP_WEBHOOK_ENABLE_CP_METER=true

# Self-signed backend in dev (https://localhost.dev)? Set to false.
# Production MUST stay true — the gateway logs a loud warning otherwise.
EVEYS_OCPP_OUTBOUND_TLS_VERIFY=true

# ---- Liveness tuning -------------------------------------------------
# Heartbeat cadence and the Redis presence TTL. Rule of thumb:
# TTL >= 2 x heartbeat. Lower values surface offline chargers sooner
# but cost more wire traffic. 60s + 120s pairs with the OCPP-1.6
# default and is the safer pick for production.
EVEYS_OCPP_HEARTBEAT_INTERVAL_SECONDS=60
EVEYS_OCPP_REDIS_ONLINE_TTL_SECONDS=120

# ---- Device authorization + IP rate limit ----------------------------
# Unknown chargers land on a Redis pending queue instead of being
# grandfathered into `charge_points`. The operator authorizes them via
# the Console (or POST /api/v1/authorizations/{cp_id}/authorize).
#
# Two clocks:
#   * PENDING_AUTHORIZATION_TTL_SECONDS — how long a pending row lives
#     in Redis before it auto-expires. Anchored at first_seen; NOT slid
#     by reconnects, so a chatty charger can't stay pending forever.
#   * PENDING_WS_TTL_SECONDS — how long a pending WS stays open before
#     the gateway force-closes it. Much shorter than the pending TTL —
#     pending sockets shouldn't squat. The Redis row survives the WS
#     close so the operator still has the full authorization window.
EVEYS_OCPP_PENDING_AUTHORIZATION_TTL_SECONDS=3600
EVEYS_OCPP_PENDING_WS_TTL_SECONDS=60

# Server-side WebSocket keepalive: how often the GATEWAY pings each
# charger, and how long it waits for the pong before closing the socket.
#
# Do not confuse these with EVEYS_OCPP_OCPP_CFG_WEBSOCKET_PING_INTERVAL_
# SECONDS, which is the OCPP `WebSocketPingInterval` key pushed TO the
# charger (it makes the charger ping us). Changing that one will not stop
# a server-side keepalive timeout.
#
# In practice this timer governs how fast a socket the charger has
# ALREADY abandoned gets reaped. Chargers that drop TCP without a close
# frame reconnect on a fresh socket immediately (look for the
# `connections.replaced` log line), so a long timeout mainly means more
# orphaned sockets held at once, not more resilience. Raise it only if
# healthy chargers on slow links are being closed mid-session; set the
# interval to 0 to disable server-initiated pings entirely.
EVEYS_OCPP_WS_KEEPALIVE_PING_INTERVAL_SECONDS=30
EVEYS_OCPP_WS_KEEPALIVE_PING_TIMEOUT_SECONDS=30

# Post-boot ChangeConfiguration push. The gateway converges chargers onto
# the EVEYS_OCPP_OCPP_CFG_* defaults after every Accepted BootNotification
# -- which means the whole burst replays on every reconnect. Both knobs
# below are runtime-overridable via /api/v1/admin/config and take effect
# on the next boot, so a flapping fleet can be tested without a deploy:
# disable the push, watch that vendor's boot rate, re-enable.
EVEYS_OCPP_OCPP_CFG_POST_BOOT_PUSH_ENABLED=true
# e.g. ISO15118PnCEnabled,PlugandChargeMode,ContractValidationOffline
EVEYS_OCPP_OCPP_CFG_POST_BOOT_PUSH_SKIP_KEYS=

# WS-upgrade IP rate limit — applies ONLY to unknown cp_ids (already-
# authorized fleet reconnects bypass it entirely). Over the cap → the
# source IP is banned for BLOCK_SECONDS.
EVEYS_OCPP_IP_RATE_LIMIT_REQUESTS_PER_MINUTE=100
EVEYS_OCPP_IP_RATE_LIMIT_BLOCK_SECONDS=3600

# ---- Host-side data plane (used when running migrations locally) -----
# The compose stack remaps Postgres to host port :55432 and ClickHouse
# to :9001 so they don't collide with locally-installed servers. Inside
# the compose network, services still talk to :5432 / :9000.
EVEYS_OCPP_DB_URL=postgresql+asyncpg://eveys:eveys@localhost:55432/eveys_ocpp
EVEYS_OCPP_CLICKHOUSE_PORT=9001

# ---- Production safety gate (Makefile) -------------------------------
# Uncomment on production hosts. Refuses destructive Makefile targets
# (compose-down, compose-down-volumes, e2e, compose-smoke, distclean,
# …) unless FORCE_PROD=1 is passed on the invocation.
# EVEYS_ENV=production
