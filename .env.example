# Generated from src/eveys_ocpp/settings.py by
# scripts/render_config_reference.py. Do not hand-edit; change
# the Settings field and run `make config-export`.
#
# Copy to .env (`cp .env.example .env`) and fill in secrets.

# ---- WS server ---------------------------------------------------

EVEYS_OCPP_WS_HOST=0.0.0.0
EVEYS_OCPP_WS_PORT=9000
EVEYS_OCPP_WS_RATE_LIMIT_ENABLED=true
EVEYS_OCPP_WS_RATE_LIMIT_CAPACITY=30
EVEYS_OCPP_WS_RATE_LIMIT_REFILL_PER_SECOND=1.0

# ---- gRPC server -------------------------------------------------

EVEYS_OCPP_GRPC_HOST=0.0.0.0
EVEYS_OCPP_GRPC_PORT=50051

# ---- REST server (ADR-0026, E3-7..E3-8) --------------------------

EVEYS_OCPP_REST_ENABLED=true
EVEYS_OCPP_REST_HOST=0.0.0.0
EVEYS_OCPP_REST_PORT=8080
EVEYS_OCPP_REST_DEFAULT_PAGE_SIZE=100
EVEYS_OCPP_REST_MAX_PAGE_SIZE=500
EVEYS_OCPP_REST_OPENAPI_ENABLED=false

# ---- Inbound auth (REST bearer + WS basic-auth + mTLS) -----------

# secret — fill from your secrets manager
EVEYS_OCPP_REST_INBOUND_TOKENS=
EVEYS_OCPP_REST_AUTH_DISABLED=false
EVEYS_OCPP_WS_MTLS_ENABLED=false
EVEYS_OCPP_WS_MTLS_CERT_PATH=
EVEYS_OCPP_WS_MTLS_KEY_PATH=
EVEYS_OCPP_WS_MTLS_CA_PATH=
EVEYS_OCPP_WS_BASIC_AUTH_REQUIRED=false

# ---- Kafka producer (ADR-0019) -----------------------------------

EVEYS_OCPP_KAFKA_BROKERS=localhost:9092
EVEYS_OCPP_KAFKA_ACKS=all
EVEYS_OCPP_KAFKA_ENABLE_IDEMPOTENCE=true
EVEYS_OCPP_KAFKA_LINGER_MS=5
EVEYS_OCPP_KAFKA_REQUEST_TIMEOUT_MS=30000
EVEYS_OCPP_KAFKA_RETRY_BACKOFF_MS=200

# ---- Kafka topics ------------------------------------------------

EVEYS_OCPP_KAFKA_TOPIC_CP_CONNECTED=cp.connected
EVEYS_OCPP_KAFKA_TOPIC_CP_DISCONNECTED=cp.disconnected
EVEYS_OCPP_KAFKA_TOPIC_CP_METER=cp.meter
EVEYS_OCPP_KAFKA_TOPIC_CP_BOOT=cp.boot
EVEYS_OCPP_KAFKA_TOPIC_CP_STATUS=cp.status
EVEYS_OCPP_KAFKA_TOPIC_CP_FIRMWARE_STATUS=cp.firmware_status
EVEYS_OCPP_KAFKA_TOPIC_CP_DIAGNOSTICS_STATUS=cp.diagnostics_status
EVEYS_OCPP_KAFKA_TOPIC_TX_STARTED=tx.started
EVEYS_OCPP_KAFKA_TOPIC_TX_STOPPED=tx.stopped
EVEYS_OCPP_KAFKA_TOPIC_CP_SECURITY_EVENT=cp.security_event

# ---- Redis (online registry + pub/sub bus, ADR-0016) -------------

EVEYS_OCPP_REDIS_URL=redis://localhost:6379/0
EVEYS_OCPP_REDIS_ONLINE_TTL_SECONDS=120

# ---- Postgres ----------------------------------------------------

# secret — fill from your secrets manager
EVEYS_OCPP_DB_URL=
EVEYS_OCPP_DB_POOL_SIZE=10
EVEYS_OCPP_DB_MAX_OVERFLOW=20

# ---- Identity (Kubernetes downward-API) --------------------------

# dynamic: defaults to a runtime value (e.g. socket.gethostname()); set explicitly in production
EVEYS_OCPP_POD_ID=

# ---- Logging -----------------------------------------------------

EVEYS_OCPP_LOG_LEVEL=INFO
EVEYS_OCPP_LOG_JSON=true

# ---- OCPP defaults -----------------------------------------------

EVEYS_OCPP_HEARTBEAT_INTERVAL_SECONDS=300

# ---- Cross-pod command bus (ADR-0016) ----------------------------

EVEYS_OCPP_BUS_REQUEST_TIMEOUT_SECONDS=30

# ---- Idempotency cache (E2-11) -----------------------------------

EVEYS_OCPP_IDEMPOTENCY_TTL_SECONDS=300

# ---- ClickHouse ingestion sidecar (ADR-0020) ---------------------

EVEYS_OCPP_CLICKHOUSE_HOST=localhost
EVEYS_OCPP_CLICKHOUSE_PORT=9000
EVEYS_OCPP_CLICKHOUSE_DB=eveys_ocpp
EVEYS_OCPP_CLICKHOUSE_INGESTOR_GROUP=eveys-ocpp-clickhouse-ingestor
EVEYS_OCPP_CLICKHOUSE_INGESTOR_BATCH_SIZE=500
EVEYS_OCPP_CLICKHOUSE_INGESTOR_BATCH_MAX_SECONDS=5.0
EVEYS_OCPP_CLICKHOUSE_INGESTOR_MAX_FLUSH_FAILURES=10

# ---- Backend integration (ADR-0023, E3-2..E3-6) ------------------

EVEYS_OCPP_BACKEND_BASE_URL=
# secret — fill from your secrets manager
EVEYS_OCPP_BACKEND_TOKEN=
EVEYS_OCPP_OUTBOUND_TLS_VERIFY=true
EVEYS_OCPP_BACKEND_TIMEOUT_AUTHORIZE_SECONDS=5.0
EVEYS_OCPP_BACKEND_TIMEOUT_SESSIONS_OPEN_SECONDS=8.0
EVEYS_OCPP_BACKEND_TIMEOUT_SESSIONS_CLOSE_SECONDS=10.0
EVEYS_OCPP_BACKEND_TIMEOUT_DEFAULT_SECONDS=5.0
EVEYS_OCPP_BACKEND_RETRY_ATTEMPTS_AUTHORIZE=1
EVEYS_OCPP_BACKEND_RETRY_ATTEMPTS_SESSIONS_OPEN=2
EVEYS_OCPP_BACKEND_RETRY_ATTEMPTS_SESSIONS_CLOSE=3
EVEYS_OCPP_BACKEND_CIRCUIT_BREAKER_THRESHOLD=5
EVEYS_OCPP_BACKEND_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0
EVEYS_OCPP_BACKEND_AUTHORIZE_FALLBACK=reject
EVEYS_OCPP_BACKEND_REGISTER_FALLBACK=accept_offline

# ---- Authorize cache (E3-4) --------------------------------------

EVEYS_OCPP_BACKEND_AUTHORIZE_CACHE_ENABLED=true
EVEYS_OCPP_BACKEND_AUTHORIZE_CACHE_TTL_SECONDS=30

# ---- Outbound webhooks (E3-9) ------------------------------------

EVEYS_OCPP_WEBHOOK_BASE_URL=
# secret — fill from your secrets manager
EVEYS_OCPP_WEBHOOK_SECRET=
EVEYS_OCPP_WEBHOOK_URL_CP_BOOT=
EVEYS_OCPP_WEBHOOK_URL_CP_FIRMWARE_STATUS=
EVEYS_OCPP_WEBHOOK_URL_CP_DIAGNOSTICS_STATUS=
EVEYS_OCPP_WEBHOOK_URL_CP_OFFLINE=
EVEYS_OCPP_WEBHOOK_URL_CP_ONLINE=
EVEYS_OCPP_WEBHOOK_URL_CP_STATUS=
EVEYS_OCPP_WEBHOOK_URL_CP_METER=
EVEYS_OCPP_WEBHOOK_URL_TX_STARTED=
EVEYS_OCPP_WEBHOOK_URL_TX_STOPPED=
EVEYS_OCPP_WEBHOOK_ENABLE_CP_BOOT=true
EVEYS_OCPP_WEBHOOK_ENABLE_CP_ONLINE=true
EVEYS_OCPP_WEBHOOK_ENABLE_CP_FIRMWARE_STATUS=true
EVEYS_OCPP_WEBHOOK_ENABLE_CP_DIAGNOSTICS_STATUS=true
EVEYS_OCPP_WEBHOOK_ENABLE_CP_OFFLINE=true
EVEYS_OCPP_WEBHOOK_ENABLE_CP_STATUS=true
EVEYS_OCPP_WEBHOOK_ENABLE_CP_METER=false
EVEYS_OCPP_WEBHOOK_ENABLE_TX_STARTED=true
EVEYS_OCPP_WEBHOOK_ENABLE_TX_STOPPED=true
EVEYS_OCPP_WEBHOOK_CONSUMER_GROUP=eveys-ocpp-webhook-dispatcher
EVEYS_OCPP_WEBHOOK_REQUEST_TIMEOUT_SECONDS=10.0
EVEYS_OCPP_WEBHOOK_MAX_ATTEMPTS=5

# ---- Prometheus metrics (Phase 4 / E4-1) -------------------------

EVEYS_OCPP_METRICS_ENABLED=true
EVEYS_OCPP_METRICS_HOST=0.0.0.0
EVEYS_OCPP_METRICS_PORT=9100
EVEYS_OCPP_METRICS_PATH=/metrics
EVEYS_OCPP_METRICS_INCLUDE_PYTHON_COLLECTORS=true

# ---- OpenTelemetry tracing (Phase 4 / E4-3) ----------------------

EVEYS_OCPP_TRACING_ENABLED=false
EVEYS_OCPP_TRACING_OTLP_ENDPOINT=http://localhost:4317
EVEYS_OCPP_TRACING_SAMPLE_RATE=1.0
EVEYS_OCPP_TRACING_SERVICE_NAME=eveys-ocpp

# ---- Sentry error tracking (Phase 4 / E4-4) ----------------------

# secret — fill from your secrets manager
EVEYS_OCPP_SENTRY_DSN=
EVEYS_OCPP_SENTRY_ENVIRONMENT=development
EVEYS_OCPP_SENTRY_RELEASE=
EVEYS_OCPP_SENTRY_TRACES_SAMPLE_RATE=0.0
EVEYS_OCPP_SENTRY_PROFILES_SAMPLE_RATE=0.0

# ---- Graceful shutdown -------------------------------------------

EVEYS_OCPP_SHUTDOWN_DRAIN_ENABLED=true
EVEYS_OCPP_SHUTDOWN_READINESS_PROPAGATION_SECONDS=10.0
EVEYS_OCPP_SHUTDOWN_GRACE_PERIOD_SECONDS=25.0
